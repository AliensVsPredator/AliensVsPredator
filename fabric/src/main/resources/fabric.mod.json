{
	"schemaVersion": 1,
	"id": "avp",
	"version": "${version}",
	"name": "${mod_name}",
	"description": "${description}",
	"accessWidener": "avp.accesswidener",
	"authors": ["Stargazer Studios"],
	"contact": {
		"homepage": "https://www.curseforge.com/minecraft/mc-mods/avp-regenesis",
		"sources": "https://github.com/AliensVsPredator/AliensVsPredator"
	},
	"license": "${license}",
	"icon": "${icon}",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.blib.fabric.BLibFabric"
		],
		"client": [
			"com.blib.fabric.client.BLibFabricClient"
		],
		"fabric-datagen": [
			"com.blib.fabric.data.BLibDataGenerator"
		],
		"rei_client": [],
		"jei_mod_plugin": []
	},
	"mixins": [
		"${mod_id}.mixins.json",
		"${mod_id}.fabric.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabric_loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": "*",
		"azurelib": ">=${azurelib_version}"
	}
}
