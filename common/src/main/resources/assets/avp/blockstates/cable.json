{
  "multipart": [
    { "apply": { "model": "avp:block/cable_core" }},

    { "when": { "north": true }, "apply": { "model": "avp:block/cable_side" }},
    { "when": { "south": true }, "apply": { "model": "avp:block/cable_side", "y": 180 }},
    { "when": { "east":  true }, "apply": { "model": "avp:block/cable_side", "y": 90 }},
    { "when": { "west":  true }, "apply": { "model": "avp:block/cable_side", "y": 270 }},
    { "when": { "up":    true }, "apply": { "model": "avp:block/cable_side", "x": 270 }},
    { "when": { "down":  true }, "apply": { "model": "avp:block/cable_side", "x": 90 }}
  ]
}
